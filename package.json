{
  "name": "@eddy-works/never-rest",
  "version": "0.3.0",
  "description": "HTTP contract library where handlers return Result instead of throwing",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "perf:check": "node scripts/typeperf.mjs",
    "specs:extract": "node scripts/extract-gherkin.mjs specs/",
    "specs:lint": "node scripts/lint-gherkin.mjs specs/",
    "docs:dev": "pnpm --filter website dev",
    "docs:build": "pnpm --filter website build",
    "examples:typecheck": "pnpm -r --filter \"./examples/**\" typecheck",
    "examples:smoke": "vitest run --config examples/smoke/vitest.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/project-eddy/never-rest.git"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "neverthrow": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.1",
    "@ark/attest": "^0.56.3",
    "@eslint/js": "^9.28.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^3.2.7",
    "arktype": "^2.2.3",
    "eslint": "^9.28.0",
    "husky": "^9.1.7",
    "neverthrow": "^8.2.0",
    "publint": "^0.3.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "valibot": "^1.4.2",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "typesVersions": {
    "*": {
      "contract": [
        "./dist/contract/index.d.ts"
      ],
      "server": [
        "./dist/server/index.d.ts"
      ],
      "client": [
        "./dist/client/index.d.ts"
      ],
      "node": [
        "./dist/node/index.d.ts"
      ],
      "testing": [
        "./dist/testing/index.d.ts"
      ]
    }
  }
}
